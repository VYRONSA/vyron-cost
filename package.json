{
  "name": "vyron-cost-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3007",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck:web": "tsc --noEmit",
    "typecheck:mobile": "npm --prefix apps/vyron-ops-mobile run typecheck",
    "typecheck": "npm run typecheck:web && npm run typecheck:mobile",
    "validate:schema": "node scripts/validate-schema-drift.mjs",
    "import:handcrafted": "node scripts/import-handcrafted.mjs",
    "generate:pwa-icons": "node scripts/generate-pwa-icons.mjs",
    "safety:run": "node scripts/safety/run.mjs",
    "safety:preflight": "node scripts/safety/preflight.mjs",
    "safety:env": "node scripts/safety/preflight.mjs --env",
    "safety:register": "node scripts/safety/preflight.mjs --register",
    "safety:verify-register": "node scripts/safety/preflight.mjs --verify-register",
    "safety:self-test": "node scripts/safety/self-test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.3",
    "exceljs": "^4.4.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.14.0",
    "next": "16.2.5",
    "openai": "^6.46.0",
    "pdfjs-dist": "^6.0.227",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-pdf": "^10.4.1",
    "sharp": "^0.35.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.5",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "to-ico": "^1.1.5",
    "typescript": "^5"
  }
}
