# VYRON COST — deployment environment variables
# Copy to .env.local for local dev and set matching values in Vercel.

# Demo tenant (Handcrafted Food Products)
NEXT_PUBLIC_VYRON_TENANT=handcrafted
NEXT_PUBLIC_VYRON_DEMO=false
NEXT_PUBLIC_VYRON_PIE_DEMO=false

# Public app URL (required for Xero OAuth redirect in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase — use project URL only (no /rest/v1/ suffix)
# Production project: https://ldnrmgafsquzfitcuvxq.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://ldnrmgafsquzfitcuvxq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Xero OAuth (set in Vercel for live integration — do not commit secrets)
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=
XERO_WEBHOOK_KEY=
